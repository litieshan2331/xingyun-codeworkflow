    "funText": "// 全局校验回调\nfunction validate() {\n    var role = getFieldValue(\"role\");\n    var empName = getFieldValue(\"emp_name\");\n    \n    if (!role || role === \"\") {\n        showMessage(\"请选择角色\");\n        return false;\n    }\n    \n    if (!empName || empName === \"\") {\n        showMessage(\"请输入姓名\");\n        return false;\n    }\n    \n    if (role === \"董事长\" || role === \"经理\") {\n        var deptId = getFieldValue(\"dept_id\");\n        if (!deptId || deptId === \"\") {\n            showMessage(\"董事长和经理必须选择部门\");\n            return false;\n        }\n    }\n    \n    return true;\n}\n\nfunction beforeSave() {\n    return validate();\n}\n\nfunction onLoad() {\n    setFieldRequired(\"role\", true);\n    setFieldRequired(\"emp_name\", true);\n}"
  },
